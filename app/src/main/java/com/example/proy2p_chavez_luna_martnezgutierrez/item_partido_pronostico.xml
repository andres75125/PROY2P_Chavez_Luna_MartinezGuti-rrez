<?xml version="1.0" encoding="utf-8"?>
<!--
    Diseño de tarjeta individual para la pantalla de Pronósticos.
    Incluye los identificadores exactos: tvInfoMatch, tvEstadoBadge, imgFlag1, imgFlag2,
    tvEquipo1, tvEquipo2, etGoles1, etGoles2, btnGuardar y tvMensajeEstado.

    @author Samantha Luna
    @version 1.0
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado con Fecha, Hora, Estadio y Badge de Estado -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvInfoMatch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/tvEstadoBadge"
                android:textColor="#666666"
                android:textSize="11sp"
                tools:text="2026-06-11 - 19:00 | Estadio Azteca" />

            <TextView
                android:id="@+id/tvEstadoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_badge_abierto"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="#2E7D32"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="ABIERTO" />
        </RelativeLayout>

        <!-- Sección de Banderas y Marcador -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- Selección Local -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgFlag1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_launcher_background" />

                <TextView
                    android:id="@+id/tvEquipo1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#102A6B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="México" />
            </LinearLayout>

            <!-- Marcador -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etGoles1"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_input_marcador"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="2"
                    android:textColor="#102A6B"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:ignore="LabelFor" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:text="-"
                    android:textColor="#666666"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etGoles2"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_input_marcador"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="2"
                    android:textColor="#102A6B"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:ignore="LabelFor" />
            </LinearLayout>

            <!-- Selección Visitante -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgFlag2"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_launcher_background" />

                <TextView
                    android:id="@+id/tvEquipo2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#102A6B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Sudáfrica" />
            </LinearLayout>
        </LinearLayout>

        <!-- Botón Guardar -->
        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#2E7D32"
            android:text="Guardar pronóstico"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:cornerRadius="20dp" />

        <!-- Banner de Mensaje de Estado -->
        <TextView
            android:id="@+id/tvMensajeEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFF8E1"
            android:padding="8dp"
            android:textAlignment="center"
            android:textColor="#F57F17"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="Los pronósticos para este partido están cerrados." />

    </LinearLayout>
</androidx.cardview.widget.CardView>