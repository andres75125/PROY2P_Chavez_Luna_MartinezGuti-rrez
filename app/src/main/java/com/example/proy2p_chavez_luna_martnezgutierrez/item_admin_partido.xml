<?xml version="1.0" encoding="utf-8"?>
<!--
    Diseño visual de tarjeta para la pantalla Administrar Partidos.
    Soluciona problemas de tamaño de toque (Touch target) y texto directo.

    @author Andres Martínez
    @version 1.0
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Información del partido y Estado -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvInfoMatch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:textColor="#666666"
                android:textSize="11sp"
                tools:text="2026-06-11 | Estadio Azteca" />

            <TextView
                android:id="@+id/tvEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:textColor="#D32F2F"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Estado: ABIERTO" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvEquipos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:textColor="#102A6B"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="México VS Sudáfrica" />

        <!-- Banderas laterales -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgFlag1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="24dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_launcher_background"
                tools:ignore="ImageContrastCheck" />

            <ImageView
                android:id="@+id/imgFlag2"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_launcher_background"
                tools:ignore="ImageContrastCheck" />
        </LinearLayout>

        <!-- Botón Cerrar Pronósticos (Altura corregida a 48dp) -->
        <Button
            android:id="@+id/btnCerrar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#C62828"
            android:text="Cerrar pronósticos"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:cornerRadius="24dp"
            tools:ignore="HardcodedText" />

        <!-- Botón Registrar Resultado Oficial (Altura corregida a 48dp) -->
        <Button
            android:id="@+id/btnRegRes"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#1565C0"
            android:text="Registrar resultado oficial"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone"
            app:cornerRadius="24dp"
            tools:ignore="HardcodedText" />

        <!-- Formulario para ingresar marcador oficial -->
        <LinearLayout
            android:id="@+id/layoutInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etGoles1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_marcador"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="2"
                    android:textColor="#102A6B"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:ignore="LabelFor" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:text="-"
                    android:textColor="#666666"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <EditText
                    android:id="@+id/etGoles2"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input_marcador"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="2"
                    android:textColor="#102A6B"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:ignore="LabelFor" />
            </LinearLayout>

            <!-- Botón Guardar Resultado (Altura corregida a 48dp) -->
            <Button
                android:id="@+id/btnGuardarRes"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#2E7D32"
                android:text="Guardar resultado"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                app:cornerRadius="24dp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>