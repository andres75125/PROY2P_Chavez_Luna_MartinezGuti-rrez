<?xml version="1.0" encoding="utf-8"?>
<!--
    Diseño del ítem individual para la pantalla "Mis pronósticos".
    Contiene los IDs exactos requeridos por MisPronosticosActivity.java:
    tvFase, tvPartido, imgFlag1, imgFlag2, tvMiPronostico, tvResultadoOficial y tvPuntos.

    @author Samantha Luna
    @version 1.0
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Encabezado con la fase del torneo -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvFase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:background="#E8EAF6"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="#3F51B5"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="Fase de grupos" />
        </RelativeLayout>

        <!-- Información de los equipos enfrentados -->
        <TextView
            android:id="@+id/tvPartido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColor="#102A6B"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="España VS Argentina" />

        <!-- Sección de banderas y pronóstico del usuario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgFlag1"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_launcher_background" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tu pronóstico"
                    android:textColor="#888888"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvMiPronostico"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#102A6B"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="2 - 1" />
            </LinearLayout>

            <ImageView
                android:id="@+id/imgFlag2"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_launcher_background" />
        </LinearLayout>

        <!-- Resultado oficial y puntos obtenidos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvResultadoOficial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:textColor="#666666"
                android:textSize="12sp"
                tools:text="Resultado: 3 - 1" />

            <TextView
                android:id="@+id/tvPuntos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Puntos: 1 pt" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>